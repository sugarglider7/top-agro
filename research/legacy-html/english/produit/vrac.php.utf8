<script language="javascript">
var ns=(navigator.appName=='Netscape')?true:false;;

function hideAll(){
 if (!ns){
 document.all.olives.style.visibility='hidden';
 document.all.abricot.style.visibility='hidden';
 document.all.divers.style.visibility='hidden';
 }
 if (ns){
 document.layers.olives.visibility='hide';
 document.layers.abricot.visibility='hide';
 document.layers.divers.visibility='hide';
 }
}

function showThis(thisis){
 if (!ns){
 eval('document.all.'+thisis+'.style.visibility="visible"');
 }
 if (ns){
 eval('document.layers.'+thisis+'.visibility="show"');
 }
}
</script>
</head>

