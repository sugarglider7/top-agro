<html>
<head>
<title>Message directe</title>
<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
<style type="text/css">
<!--
.text {  font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold}
.text2 { font-family: Arial, Helvetica, sans-serif; font-size: 14pt; font-weight: bold }
-->
</style>
</head>

<body bgcolor="#FDE3C8" leftmargin="0" topmargin="0" marginwidth="0" marginheight="0">
<form name="info" action="mailto:topagro@iam.net.ma?subject=message via le site topagro.com" method="post">
  <table width="374" border="0" cellspacing="2" cellpadding="3">
    <tr> 
      <td colspan="2" class="text2" height="40" align="center">Leave us a message</td>
    </tr>
    <tr> 
      <td width="103" class="text" align="right">Name :</td>
      <td width="239"> 
        <input type="text" name="nom" maxlength="30" size="30">
      </td>
    </tr>
    <tr> 
      <td width="103" class="text" align="right">Office :</td>
      <td width="239"> 
        <input type="text" name="occupation" maxlength="30" size="30">
      </td>
    </tr>
    <tr> 
      <td width="103" class="text" align="right">Company :</td>
      <td width="239"> 
        <input type="text" name="company" maxlength="30" size="30">
      </td>
    </tr>
    <tr> 
      <td width="103" class="text" align="right">The company's <br>
        activities :</td>
      <td width="239"> 
        <input type="text" name="activite" maxlength="30" size="30">
      </td>
    </tr>
    <tr> 
      <td width="103" class="text" align="right">Country :</td>
      <td width="239"> 
        <input type="text" name="pays" maxlength="30" size="30">
      </td>
    </tr>
    <tr> 
      <td width="103" class="text" align="right">e-mail :</td>
      <td width="239"> 
        <input type="text" name="e-mail" maxlength="30" size="30">
      </td>
    </tr>
    <tr> 
      <td width="103" class="text" align="right">message :</td>
      <td width="239"> 
        <textarea name="message" cols="29" rows="10"></textarea>
      </td>
    </tr>
    <tr> 
      <td align="center">&nbsp; </td>
      <td> 
        <input type="submit" name="Submit" value="Send">
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
        <input type="reset" name="reset" value="Clear">
      </td>
    </tr>
  </table>
</form>
<p align="left"><font color="#CCCCCC" size="1"><a href="http://www.agencecouleurs.com" target="_blank">Création site web <strong>Couleurs Com</strong></a> <a href="../marrakech.php" target="_blank">Marrakech</a></font> 
<a href="http://www.marrakechpocket.com" target="_blank"><font color="#FFe3c8" size="1">Immobilier Marrakech</font></a> <a href="http://www.marrakechpocket.com" target="_blank"><font color="#FFe3c8" size="1">Riad Marrakech</font></a>
</body>
</html>
